#!/bin/bash
# Control and install the launchd-managed agent.
#
#   ./scripts/agentctl install           # render + load the agent job (auto-start, auto-restart)
#   ./scripts/agentctl install-backup    # render + load the daily 04:10 sqlite backup
#   ./scripts/agentctl uninstall         # unload both jobs
#   ./scripts/agentctl start|stop|restart|status   # restart waits for the running turn to settle
#                                                # (--force kills it; durable storage resumes it)
#   ./scripts/agentctl restart-later             # same wait, run by launchd as its own one-shot job, so
#                                                # the caller may be the agent itself (see restart-once)
#   ./scripts/agentctl logs [n]          # agent log tail
#   ./scripts/agentctl backup            # run a backup now
#   ./scripts/agentctl backups           # list snapshots
#   ./scripts/agentctl doctor            # diagnose why it will not start
#   ./scripts/agentctl rotate            # trim logs now (LOG_MAX_BYTES, default 5 MB × 3)
#   ./scripts/agentctl restore <file>    # restore a snapshot (stops the agent first)
#
# NODE_BIN overrides the node binary baked into the plist (default: `command -v node`).
set -euo pipefail

LOG_MAX_BYTES="${LOG_MAX_BYTES:-5242880}"   # 5 MB per file, three generations: about a week

LABEL="com.pitta.agent"
BACKUP_LABEL="$LABEL.backup"
# A restart asked for from inside a turn cannot do the bootout itself: the bootout
# kills the turn mid-sentence. This second job does the waiting instead, and being
# a job of its own it survives the agent going away.
LATER_LABEL="$LABEL.restart-later"
PROJECT="$(cd "$(dirname "$0")/.." && pwd)"
AGENTS="$HOME/Library/LaunchAgents"
DOMAIN="gui/$(id -u)"

render() {
  local template="$1" label="$2" output="$3"
  if [ ! -f "$template" ]; then
    echo "missing template: $template" >&2
    exit 1
  fi
  local node_bin="${NODE_BIN:-}"
  if [ -z "$node_bin" ]; then
    node_bin="$(command -v node || true)"
  fi
  if [ -z "$node_bin" ]; then
    echo "node not found in PATH; set NODE_BIN=/path/to/node" >&2
    exit 1
  fi
  mkdir -p "$AGENTS" "$PROJECT/logs"
  # Paths may contain spaces or slashes; sed with | as separator keeps this readable.
  sed -e "s|__LABEL__|$label|g" \
      -e "s|__PROJECT__|$PROJECT|g" \
      -e "s|__NODE__|$node_bin|g" \
      -e "s|__HOME__|$HOME|g" \
      "$template" > "$output"
  echo "rendered $output (node: $node_bin)"
}

# launchd redirects stdout into these files and never reopens them, so a rename is only safe while
# the job is stopped: otherwise the process keeps writing to the renamed inode.
rotate_logs() {
  local logs="$PROJECT/logs"
  [ -d "$logs" ] || return 0
  local base file size
  for base in agent.log agent.err.log backup.log backup.err.log; do
    file="$logs/$base"
    [ -f "$file" ] || continue
    size=$(wc -c < "$file" | tr -d ' ')
    [ "$size" -ge "$LOG_MAX_BYTES" ] || continue
    rm -f "$file.3"
    if [ -f "$file.2" ]; then mv "$file.2" "$file.3"; fi
    if [ -f "$file.1" ]; then mv "$file.1" "$file.2"; fi
    mv "$file" "$file.1"
    : > "$file"
    echo "rotated $base ($((size / 1024)) KB → $base.1)"
  done
}

# A queued or placed submission is a turn that has not settled yet: model call, tool call, delivery.
# Restarting under it cuts the turn, and the surface that owns it has to recover a half-written card
# afterwards — which is how a "quick restart" turns into a duplicated answer.
db_path() { echo "${AGENT_DB:-$PROJECT/.data/agent.sqlite}"; }

turns_in_flight() {
  local db; db="$(db_path)"
  [ -f "$db" ] || { echo 0; return; }
  sqlite3 "file:$db?mode=ro" "select count(*) from submissions where status in ('queued','placed')" 2>/dev/null || echo 0
}

wait_idle() {
  local timeout="${RESTART_IDLE_TIMEOUT:-180}" deadline=$((SECONDS + ${RESTART_IDLE_TIMEOUT:-180}))
  local count
  count="$(turns_in_flight)"
  [ "$count" = "0" ] && return 0
  echo "agent has $count turn(s) in flight; waiting up to ${timeout}s for them to settle"
  while [ "$(turns_in_flight)" != "0" ]; do
    if [ "$SECONDS" -ge "$deadline" ]; then
      echo "still mid-turn after ${timeout}s — not restarting." >&2
      echo "the turn is running in this very process if you started agentctl from inside it;" >&2
      echo "use 'agentctl restart --force' to cut it (the turn resumes on the next start, but any" >&2
      echo "half-delivered card is recovered by the surface, not resent)." >&2
      return 1
    fi
    sleep 2
  done
  echo "agent idle; restarting"
  return 0
}

# render_later writes the one-shot restart job. KeepAlive must stay false: on
# 2026-11-18 a restart submitted through `launchctl submit` was re-run every 25 s
# (20 s sleep + bootout + bootstrap), which restarted the agent 26 times in eleven
# minutes and killed the turn that asked for it each time.
render_later() {
  mkdir -p "$AGENTS" "$PROJECT/logs"
  cat > "$AGENTS/$LATER_LABEL.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$LATER_LABEL</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>$PROJECT/scripts/agentctl</string>
    <string>restart-once</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><false/>
  <key>AbandonProcessGroup</key><true/>
  <key>StandardOutPath</key><string>$PROJECT/logs/restart-later.log</string>
  <key>StandardErrorPath</key><string>$PROJECT/logs/restart-later.log</string>
</dict>
</plist>
PLIST
}

load() {
  local label="$1" plist="$2"
  launchctl bootout "$DOMAIN" "$plist" 2>/dev/null || true
  launchctl bootstrap "$DOMAIN" "$plist"
  launchctl enable "$DOMAIN/$label"
}

case "${1:-status}" in
  install)
    render "$PROJECT/launchd/agent.plist.tmpl" "$LABEL" "$AGENTS/$LABEL.plist"
    rotate_logs
    load "$LABEL" "$AGENTS/$LABEL.plist"
    echo "agent installed; logs: $PROJECT/logs/agent.log"
    ;;
  install-backup)
    render "$PROJECT/launchd/backup.plist.tmpl" "$BACKUP_LABEL" "$AGENTS/$BACKUP_LABEL.plist"
    load "$BACKUP_LABEL" "$AGENTS/$BACKUP_LABEL.plist"
    echo "daily backup installed (04:10); logs: $PROJECT/logs/backup.log"
    ;;
  uninstall)
    for pair in "$LABEL:$AGENTS/$LABEL.plist" "$BACKUP_LABEL:$AGENTS/$BACKUP_LABEL.plist"; do
      label="${pair%%:*}"; plist="${pair#*:}"
      launchctl bootout "$DOMAIN" "$plist" 2>/dev/null || true
      rm -f "$plist"
      echo "unloaded $label"
    done
    ;;
  start)
    launchctl kickstart "$DOMAIN/$LABEL"
    ;;
  stop)
    launchctl kill SIGTERM "$DOMAIN/$LABEL" 2>/dev/null || launchctl bootout "$DOMAIN" "$AGENTS/$LABEL.plist"
    ;;
  restart)
    # Never cut a turn in half: wait for the queue to drain first unless forced.
    if [ "${2:-}" != "--force" ]; then
      wait_idle || exit 1
    fi
    # kickstart -k keeps the same file descriptors, so rotation has to go through a full reload.
    launchctl bootout "$DOMAIN" "$AGENTS/$LABEL.plist" 2>/dev/null || true
    rotate_logs
    load "$LABEL" "$AGENTS/$LABEL.plist"
    ;;
  restart-later)
    # Queue one restart, run by launchd. Used when the caller is the agent itself:
    # this process goes away with the bootout, so nothing here can watch the turn end.
    render_later
    launchctl bootout "$DOMAIN" "$AGENTS/$LATER_LABEL.plist" 2>/dev/null || true
    launchctl bootstrap "$DOMAIN" "$AGENTS/$LATER_LABEL.plist"
    launchctl enable "$DOMAIN/$LATER_LABEL"
    echo "queued: restarts once the running turn settles (log: logs/restart-later.log)"
    ;;
  restart-once)
    # What launchd runs. It unloads itself first so a slow or failed restart cannot
    # pile up a queue of jobs waiting to do the same thing.
    launchctl bootout "$DOMAIN" "$AGENTS/$LATER_LABEL.plist" 2>/dev/null || true
    if ! wait_idle; then
      echo "left the agent alone: still mid-turn"
      exit 1
    fi
    launchctl bootout "$DOMAIN" "$AGENTS/$LABEL.plist" 2>/dev/null || true
    rotate_logs
    load "$LABEL" "$AGENTS/$LABEL.plist"
    echo "restarted at $(date '+%Y-%m-%d %H:%M:%S')"
    ;;
  status)
    for label in "$LABEL" "$BACKUP_LABEL"; do
      if launchctl print "$DOMAIN/$label" >/dev/null 2>&1; then
        echo "== $label"
        launchctl print "$DOMAIN/$label" | grep -E "state = |pid = |last exit code|runs = " | sed 's/^/  /'
      else
        echo "== $label: not loaded"
      fi
    done
    ;;
  logs)
    tail -n "${2:-50}" "$PROJECT/logs/agent.log"
    ;;
  rotate)
    rotate_logs
    ;;
  backup)
    "$PROJECT/scripts/backup-db"
    ;;
  doctor)
    "${PROJECT}/scripts/doctor"
    ;;
  backups)
    ls -lht "${BACKUP_DIR:-$PROJECT/backups}" 2>/dev/null | head -n "${2:-10}" || echo "no backups yet"
    ;;
  restore)
    src="${2:-}"
    if [ -z "$src" ] || [ ! -f "$src" ]; then
      echo "usage: $0 restore <backup file>" >&2
      exit 2
    fi
    echo "stopping agent before replacing the database"
    launchctl kill SIGTERM "$DOMAIN/$LABEL" 2>/dev/null || true
    # Wait for the process to actually exit: replacing the file under a live
    # connection would leave a stale WAL behind and lose the restore.
    for _ in $(seq 1 20); do
      if ! pgrep -f "$PROJECT/src/main.ts" >/dev/null 2>&1; then break; fi
      sleep 1
    done
    if pgrep -f "$PROJECT/src/main.ts" >/dev/null 2>&1; then
      echo "agent still running after 20s; aborting restore" >&2
      exit 1
    fi
    db="${AGENT_DB:-$PROJECT/.data/agent.sqlite}"
    cp "$db" "$db.before-restore-$(date +%Y%m%d-%H%M%S)" 2>/dev/null || true
    cp "$src" "$db"
    rm -f "${db}-wal" "${db}-shm"
    echo "restored $src → $db; starting agent"
    launchctl kickstart "$DOMAIN/$LABEL"
    ;;
  *)
    grep '^#' "$0" | sed -n '2,15p' | sed 's/^# \{0,1\}//' >&2
    exit 2
    ;;
esac
