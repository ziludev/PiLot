#!/bin/bash
# Thin shim. The control logic lives in agentctl/ (Go) and is built into bin/agentctl; this path
# stays because launchd plists, client-go's Restart/Backup buttons, src/cli/main.ts and the docs all
# call it here. Rebuilds when the sources are newer than the binary.
set -euo pipefail

PROJECT="$(cd "$(dirname "$0")/.." && pwd)"
BIN="$PROJECT/bin/agentctl"
SOURCE="$PROJECT/agentctl"

needs_build() {
  [ ! -x "$BIN" ] && return 0
  [ -d "$SOURCE" ] || return 1
  [ -n "$(find "$SOURCE" -name '*.go' -newer "$BIN" -print -quit)" ]
}

if needs_build; then
  if command -v go >/dev/null 2>&1; then
    # A failed rebuild is not fatal while an older binary is there to run: launchd calls this at
    # 04:10 with nobody watching, and a backup from yesterday's code beats no backup.
    if ! ( cd "$SOURCE" && go build -o "$BIN" . ); then
      [ -x "$BIN" ] || { echo "agentctl: build failed and $BIN is missing" >&2; exit 1; }
      echo "agentctl: rebuild failed, running the existing binary" >&2
    fi
  elif [ ! -x "$BIN" ]; then
    echo "agentctl: $BIN is missing and go is not on PATH" >&2
    exit 1
  fi
fi

exec "$BIN" "$@"
