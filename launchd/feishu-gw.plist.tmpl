<?xml version="1.0" encoding="UTF-8"?>
<!--
  Rendered by `scripts/agentctl install` into ~/Library/LaunchAgents/.
  Placeholders: __LABEL__ __PROJECT__ __HOME__
  Do not edit the installed copy: change this template and reinstall.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>__LABEL__</string>

  <key>ProgramArguments</key>
  <array>
    <string>__PROJECT__/bin/feishu-gw</string>
    <string>-env</string>
    <string>__PROJECT__/.env</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__PROJECT__</string>

  <!-- The bot is deaf without this process: a crash must not mean silence until someone notices. -->
  <key>KeepAlive</key>
  <true/>
  <key>RunAtLoad</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>

  <key>StandardOutPath</key>
  <string>__PROJECT__/logs/feishu-gw.log</string>
  <key>StandardErrorPath</key>
  <string>__PROJECT__/logs/feishu-gw.err.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>__HOME__/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>HOME</key>
    <string>__HOME__</string>
  </dict>
</dict>
</plist>
